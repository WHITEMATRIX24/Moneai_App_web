PORT=5001
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_NAME=MONE AI Admin
ADMIN_EMAIL=admin@moneai.local
ADMIN_PASSWORD=ChangeMe123!
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------
# AI module (server/src/services/ai, server/src/ai)
# ------------------------------------------------------------------

# Which provider handles chat generation. One of: gemini | openai | anthropic | qwen
AI_PROVIDER=gemini

# Optional: if AI_PROVIDER's call fails, retry once against this provider
# instead (see aiProvider.service.js's withFallback()). Leave blank to disable.
# qwen (via OpenRouter's free tier) is a reasonable fallback if your primary
# is a paid/rate-limited key — see qwen.provider.js for setup.
AI_FALLBACK_PROVIDER=

# --- Generic model names (used when no provider-specific override below is set) ---
AI_PRIMARY_MODEL=gemini-2.5-flash
AI_FAST_MODEL=gemini-2.0-flash-lite
AI_EMBEDDING_MODEL=text-embedding-004

# --- Per-provider overrides (optional — only needed if AI_FALLBACK_PROVIDER
#     or AI_EMBEDDING_PROVIDER point at a different vendor than AI_PROVIDER) ---
# AI_OPENAI_PRIMARY_MODEL=gpt-4o
# AI_OPENAI_FAST_MODEL=gpt-4o-mini
# AI_ANTHROPIC_PRIMARY_MODEL=claude-sonnet-4-6
# AI_ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# Qwen free-tier model IDs on OpenRouter rotate — verify at
# https://openrouter.ai/models?max_price=0 before relying on the default
# baked into aiProvider.service.js's DEFAULT_MODELS.qwen.
# AI_QWEN_PRIMARY_MODEL=qwen/qwen3.6-plus:free
# AI_QWEN_FAST_MODEL=qwen/qwen3-8b:free

# --- API keys — only the ones for providers you actually use ---
AI_API_KEY=                 # Gemini key (also accepted as AI_GEMINI_API_KEY)
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_QWEN_API_KEY=            # An OpenRouter key (openrouter.ai/keys), not an Alibaba one
# AI_QWEN_APP_URL=          # optional — OpenRouter attribution header (HTTP-Referer)
# AI_QWEN_APP_NAME=         # optional — OpenRouter attribution header (X-Title)

AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.3

# --- Tool orchestration / token optimization / summarization ---
AI_MAX_TOOL_ITERATIONS=3      # cap on chained tool calls per turn
AI_HISTORY_TOKEN_BUDGET=2000  # trims oldest history messages beyond this estimate
AI_SUMMARY_TRIGGER_COUNT=20   # fold older turns into AIConversation.summary past this count
AI_SUMMARY_KEEP_RECENT=10     # how many recent turns stay out of the summary

# --- Rate limiting (server/src/middleware/aiRateLimit.middleware.js) ---
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200
